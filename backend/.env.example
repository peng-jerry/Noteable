# Copy to backend/.env for local development. Never commit the real .env.

# development | testing | production
APP_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Leave unset locally to use SQLite (backend/instance/noteable-dev.db).
# In production: the Neon/Supabase Postgres connection string.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Comma-separated frontend origins allowed to call the API (scheme + host, no path).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional tuning (defaults shown)
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=30
# RATELIMIT_AUTH=10 per minute
# RATELIMIT_DEFAULT=300 per minute
# PROXY_HOPS=1
# LOG_LEVEL=INFO
